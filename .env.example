# ==========================================
# INBOX ZERO DUNGEON — BACKEND ENVIRONMENT
# ==========================================

# Port for the Node.js backend server
PORT=3001

# Google Gemini API Key (Secret - NEVER expose to frontend or git)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud OAuth 2.0 Credentials (For Real Gmail Integration)
# Create in Google Cloud Console -> APIs & Services -> Credentials
# Required Scopes: https://www.googleapis.com/auth/gmail.modify, https://www.googleapis.com/auth/userinfo.email
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# Session Secret for signed authentication cookies
SESSION_SECRET=dungeon-arcane-session-secret-key-change-in-production

# Frontend Origin for OAuth redirect
FRONTEND_ORIGIN=http://localhost:5173

# Firebase Admin SDK Configuration (For Cloud Firestore Data Persistence)
# Option 1: Place serviceAccountKey.json in the project root directory
# Option 2: Provide credentials directly via environment variables:
FIREBASE_PROJECT_ID=inbox-zero-dungeon
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@inbox-zero-dungeon.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
